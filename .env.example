# Copy to .env and fill in. Never commit .env.

# Required. Signs session cookies. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LEDGERLINE_SECRET_KEY=

# Required for docker compose. Password of the ledgerline database owner (migrations, backups).
POSTGRES_PASSWORD=

# Required for docker compose. Password of the restricted ledgerline_app role that the app and
# worker connect as. Tenant isolation depends on this role: it cannot bypass row-level security.
# Use hex or letters and digits (it is embedded in a database URL): openssl rand -hex 24
LEDGERLINE_APP_DB_PASSWORD=

# Outside compose: the app and worker connect as ledgerline_app, migrations as the owner.
# LEDGERLINE_DATABASE_URL=postgresql+psycopg://ledgerline_app:<password>@localhost:5432/ledgerline
# LEDGERLINE_MIGRATION_DATABASE_URL=postgresql+psycopg://ledgerline:<password>@localhost:5432/ledgerline
# Unset = migrations use LEDGERLINE_DATABASE_URL (local development with one superuser only).

# Session cookie only sent over HTTPS. Keep true behind a TLS proxy.
# Set to false ONLY for local http://localhost testing.
LEDGERLINE_COOKIE_SECURE=true

# Session lifetime in seconds (default 8 hours).
# LEDGERLINE_SESSION_MAX_AGE_SECONDS=28800

# Max size of an uploaded file in bytes (default 10 MiB).
# LEDGERLINE_MAX_UPLOAD_BYTES=10485760

# Who runs this installation. Shown on the privacy notice and the terms of use. Required in
# production: /healthz/deep fails until all four are set. Use your registered details.
LEDGERLINE_OPERATOR_LEGAL_NAME=
LEDGERLINE_OPERATOR_KVK_NUMBER=
LEDGERLINE_OPERATOR_ADDRESS=
LEDGERLINE_OPERATOR_CONTACT_EMAIL=

# Optional: create this owner on first start (needs both; password at least 12 characters).
# Remove the password from .env after the first start.
LEDGERLINE_INITIAL_OWNER_EMAIL=
LEDGERLINE_INITIAL_PASSWORD=

# Address the app port is published on. Default keeps it local; the reverse proxy fronts it.
# LEDGERLINE_BIND=127.0.0.1:8000

# Backups (compose "backup" service): UTC hour of the nightly dump and retention in days for the
# local copies in ./backups.
# BACKUP_HOUR_UTC=2
# BACKUP_KEEP_DAYS=30
# Weekday (1=Mon..7=Sun) of the weekly "restic check".
# BACKUP_CHECK_WEEKDAY=7

# Off-site copy with restic to S3-compatible storage (docs/OPERATIONS.md). Retention: 14 daily,
# 8 weekly, 24 monthly, 8 yearly. Keep RESTIC_PASSWORD in a password manager too: without it the
# backups cannot be read. An absolute path as repository is a local (file) repository.
# RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# Monitoring. /healthz/deep is for an external uptime monitor. Dead-man's-switch ping URLs
# (healthchecks.io or self-hosted), one check each: the worker pings every
# LEDGERLINE_HEALTHCHECK_PING_SECONDS, the backup job pings at start, success and failure.
# Set the flag to true on a hosted server: /healthz/deep then fails until a backup reached the
# off-site repository.
# LEDGERLINE_HEALTHCHECK_PING_URL=
# LEDGERLINE_HEALTHCHECK_PING_SECONDS=300
# BACKUP_HEALTHCHECK_PING_URL=
# LEDGERLINE_HEALTH_REQUIRE_OFFSITE_BACKUP=false
# Behind a reverse proxy on the same host the compose file trusts its forwarded headers
# (FORWARDED_ALLOW_IPS, default "*", safe while LEDGERLINE_BIND stays on loopback). If you
# publish the port on a public address, set it to the proxy's address.
# FORWARDED_ALLOW_IPS=*
# /healthz/deep fails when the disk holding the ops volume has less than this percentage free
# (whole number 1-99, default 10). The app refuses to start with any other value.
# LEDGERLINE_HEALTH_MIN_FREE_DISK_PERCENT=10

# Public HTTPS address of this server; shown in the phone shortcut instructions.
# LEDGERLINE_PUBLIC_BASE_URL=https://books.example.com

# Source code link in the app footer (AGPL-3.0 section 13). Point it at your fork if you change the code.
# LEDGERLINE_SOURCE_URL=https://github.com/RAJUSHANIGARAPU/ledgerline

# Outbound email for invitations and password reset. Empty host = email off (invitations are refused).
# LEDGERLINE_SMTP_HOST=smtp.example.com
# LEDGERLINE_SMTP_PORT=587
# starttls (587), ssl (465) or none (trusted local relay only)
# LEDGERLINE_SMTP_TLS=starttls
# LEDGERLINE_SMTP_USER=
# LEDGERLINE_SMTP_PASSWORD=
# LEDGERLINE_SMTP_FROM=Ledgerline <noreply@books.example.com>
# "development" writes invitation and reset links to the server log when SMTP is off. Never in production.
# LEDGERLINE_ENVIRONMENT=production

# Email intake (worker service). Use an app password, not your main mailbox password.
# Mail to user+<inbox token>@domain goes to that administration (the address is shown on the
# Inbox page and in Settings). Mail without a valid token goes to the default administration
# below on single-tenant installs and is moved to the Rejected folder when several tenants exist.
# LEDGERLINE_IMAP_HOST=imap.example.com
# LEDGERLINE_IMAP_PORT=993
# LEDGERLINE_IMAP_USER=invoices@example.com
# LEDGERLINE_IMAP_PASSWORD=
# LEDGERLINE_IMAP_FOLDER=INBOX
# LEDGERLINE_IMAP_PROCESSED_FOLDER=Ledgerline/Processed
# LEDGERLINE_IMAP_POLL_SECONDS=300
# Single-tenant installs only:
# LEDGERLINE_IMAP_DEFAULT_ADMINISTRATION_ID=1
# Comma-separated senders or @domains; empty accepts any sender (From can be spoofed).
# LEDGERLINE_IMAP_ALLOWED_SENDERS=

# Reading photos and scans (off by default). "anthropic" sends those documents (and any PDF whose text could not be parsed) to Anthropic's API;
# read docs/EXTRACTION.md (privacy, processing agreement, cost) before switching it on.
# LEDGERLINE_EXTRACTION_PROVIDER=none   # none | anthropic | openrouter
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Set the model together with provider=anthropic (recommended for the pilot):
# LEDGERLINE_EXTRACTION_MODEL=claude-haiku-5-5
# LEDGERLINE_EXTRACTION_MONTHLY_LIMIT=200

# A bank payment this many cents away from an open invoice still proposes it (shown as
# "difference EUR 0.01"). The owner confirms; the difference goes to Rounding differences (4890).
# LEDGERLINE_BANK_MATCH_TOLERANCE_CENTS=2
