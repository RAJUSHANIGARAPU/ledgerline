# Written to /home/deploy/ledgerline/.env by the bootstrap. Values in double braces are filled with
# values generated on the server; everything below "Fill in" is yours (see docs/OPERATIONS.md).
LEDGERLINE_SECRET_KEY={{SECRET_KEY}}
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
LEDGERLINE_APP_DB_PASSWORD={{APP_DB_PASSWORD}}
LEDGERLINE_COOKIE_SECURE=true
LEDGERLINE_BIND=127.0.0.1:8000
LEDGERLINE_PUBLIC_BASE_URL=https://{{DOMAIN}}
LEDGERLINE_INITIAL_OWNER_EMAIL={{OWNER_EMAIL}}
LEDGERLINE_INITIAL_PASSWORD={{INITIAL_PASSWORD}}

# /healthz/deep returns 503 until the backup reached the off-site repository.
LEDGERLINE_HEALTH_REQUIRE_OFFSITE_BACKUP=true
# /healthz/deep fails below this percentage of free disk (1-99). Size the volume for 30 days of
# dumps plus images before lowering it.
LEDGERLINE_HEALTH_MIN_FREE_DISK_PERCENT=10

# --- Fill in, then run: docker compose up -d ---
# REQUIRED, owner values (no defaults): who runs this service, shown in the legal pages. /healthz/deep
# returns 503 until all four are set.
LEDGERLINE_OPERATOR_LEGAL_NAME=
LEDGERLINE_OPERATOR_KVK_NUMBER=
LEDGERLINE_OPERATOR_ADDRESS=
LEDGERLINE_OPERATOR_CONTACT_EMAIL=

# Off-site backups (restic, S3-compatible storage). Keep RESTIC_PASSWORD in your password
# manager too: without it the backups cannot be read.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Dead-man's-switch check URLs (healthchecks.io or self-hosted); one check per URL.
BACKUP_HEALTHCHECK_PING_URL=
LEDGERLINE_HEALTHCHECK_PING_URL=

# Photos and scans (off by default; nothing leaves the server). Read docs/EXTRACTION.md first:
# it needs a processing agreement with Anthropic and a line in the privacy notice.
LEDGERLINE_EXTRACTION_PROVIDER=none
# LEDGERLINE_EXTRACTION_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
