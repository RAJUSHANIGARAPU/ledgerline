{{DOMAIN}} {
    encode zstd gzip
    header {
        # Start short; raise to 31536000 once HTTPS has held for a few weeks (browsers cache it).
        Strict-Transport-Security "max-age=3600"
        -Server
    }
    # Bulk upload on the inbox page: many files in one request. The app still refuses any single
    # file above LEDGERLINE_MAX_UPLOAD_BYTES (10 MiB), so this only sets the size of a whole batch.
    @bulk {
        method POST
        path /inbox/upload
    }
    handle @bulk {
        request_body {
            max_size 200MB
        }
        reverse_proxy 127.0.0.1:8000
    }
    # Everything else keeps the small cap (one file per request, plus form overhead).
    handle {
        request_body {
            max_size 12MB
        }
        reverse_proxy 127.0.0.1:8000
    }
}
